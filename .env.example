# Copy to .env and fill in. .env is gitignored and must stay that way.

POSTGRES_DB=opsintake
POSTGRES_USER=ops_owner
POSTGRES_PASSWORD=            # openssl rand -hex 16

# Encrypts every credential you save in the n8n UI. Back this up somewhere
# that is not this machine: without it the workflows still open and every
# password inside them is gone.
N8N_ENCRYPTION_KEY=           # openssl rand -hex 32
